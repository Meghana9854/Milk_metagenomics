## FUNCTIONAL ANNOTATION OF MAGs USING eggNOG-mapper v2 ##
# setting path to the eggnog dbs
export EGGNOG_DATA_DIR=../eggnog_db
for i in $(cat ../high_qual_bins.txt)
do
mkdir -p "$i"
emapper.py -m diamond --itype metagenome --genepred prodigal --cpu 25 -i ../../6.MAGs/output/final_bins/"$i".fa -o ./"$i" --dmnd_iterate no --excel
done
module unload

## using CD HIT to cluster the genes of interest (potential chlorate reducing genes) ##
module load cd-hit/4.8.1
mkdir -p cd_hit_output
cd-hit -i all_gene_seqs.fasta -o cd_hit_output/cd_hit_output.fasta -c 0.98 -s 0.7 -n 5 -T 8 -sc 0
module unload cd-hit/4.8.1

## Identifying potential chlorate reducing genes from the short read datasets ##
# using DIAMOND for protein vs DNA alignments
mkdir -p diamond_db
module load diamond/2.1.8-162
diamond makedb --in cd_hit_output/cd_hit_output.fasta -d diamond_db
module unload diamond/2.1.8-162
# moving the diamond db
mv diamond_db.dmnd diamond_db

## Using diamond blastx mode for aligning short reads to the protien ref database (chlorate reduction genes of interest) ##
module load diamond/2.1.8-162
mkdir -p 10.genes_of_interest/3.reads_mapped
cd 10.genes_of_interest/3.reads_mapped
for i in $(cat ../../filename_reads.txt)
do
diamond blastx -q "$i"_goi.fasta \
 -d diamond_db/diamond_db.dmnd -o "$i"_gene_matches.tsv --threads 16
done
module unload diamond/2.1.8-162

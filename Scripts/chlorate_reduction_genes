# using diamond blastx mode for aligning reads (DNA seqs) to the protien ref database (with genes of interest)
module load diamond/2.1.8-162
#mkdir -p 10.genes_of_interest/3.reads_mapped
#cd 10.genes_of_interest/3.reads_mapped
for i in $(cat ../../filename_reads.txt)
do
diamond blastx -q ../../9.superfocus_reads/1.merged_reads/"$i"_merged.fasta \
 -d ../2.extracted_sequences/all_genes_fasta_renamed/diamond_db/diamond_db.dmnd -o "$i"_gene_matches.tsv --threads 16
# not using senitive or ultra sensitive becsue with wnat higher identity or stronger matches >70% (look at https://github.com/bbuchfink/diamond/wiki/1.-Tutorial)
done
module unload diamond/2.1.8-162



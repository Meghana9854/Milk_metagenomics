## FUNCTIONAL ANNOTATION OF MAGs USING eggNOG-mapper v2 ##
# setting path to the eggnog dbs
export EGGNOG_DATA_DIR=../eggnog_db
for i in $(cat ../high_qual_bins.txt)
do
mkdir -p "$i"
emapper.py -m diamond --itype metagenome --genepred prodigal --cpu 25 -i ../../6.MAGs/output/final_bins/"$i".fa -o ./"$i" --dmnd_iterate no --excel
done
module unload

##### pulling out only the genes of interest ####
awk -F'\t' '($9 ~ /narG|narZ|narH|narI|napA|napB|nasA|nirB|nirD|nrfH|nirS|norC|nosZ|ynfE|ynfF|dmsA2|dmsA|torA|torZ|bisC|ydeP|ywfI|cld/) || ($9 == "-" && $21 ~ /Molybdopterin|Chlor_dismutase/)' "$i".emapper.annotations > 10.genes_of_interest/1.genes_input/all_genes_of_interest_filtered.txt

